+    /**
+     * Validates and stores an uploaded payment logo in modules/niubiz/img/ (same folder as before).
+     *
+     * The image is re-encoded with PrestaShop's ImageManager and the temporary upload is left untouched
+     * (it is NOT moved with move_uploaded_file): on PrestaShop 8/9 the Symfony request still holds a
+     * reference to the temporary file, and moving it makes the back office crash afterwards with
+     * "FileNotFoundException: The file /tmp/phpXXXX does not exist".
+     *
+     * @return string|false File name stored in img/, or false (messages are appended to $errors)
+     */
+    protected function saveLogoUpload(array $file, $idLang, array &$errors)
+    {
+        if (isset($file['error']) && (int) $file['error'] !== UPLOAD_ERR_OK) {
+            $errors[] = $this->trans('An error occurred while attempting to upload the file.', array(), 'Admin.Notifications.Error');
+            return false;
+        }
+
+        if ($error = ImageManager::validateUpload($file, 4000000, array('jpg', 'jpeg', 'gif', 'png'))) {
+            $errors[] = $error;
+            return false;
+        }
+
+        $info = @getimagesize($file['tmp_name']);
+        $extensions = array('image/png' => 'png', 'image/gif' => 'gif', 'image/jpeg' => 'jpg');
+        if (!$info || !isset($extensions[$info['mime']])) {
+            $errors[] = $this->trans('Invalid image', array(), 'Admin.Notifications.Error');
+            return false;
+        }
+        $ext = $extensions[$info['mime']];
+
+        $dir = $this->getLocalPath().'img/';
+        if (!is_dir($dir) && !@mkdir($dir, 0755, true)) {
+            $errors[] = $this->trans('An error occurred while attempting to upload the file.', array(), 'Admin.Notifications.Error');
+            return false;
+        }
+
+        $fileName = 'logo_'.(int) $idLang.'_'.Tools::passwdGen(10, 'NO_NUMERIC').'.'.$ext;
+        // Original size is kept (width/height null); PNG/GIF transparency is preserved.
+        if (!ImageManager::resize($file['tmp_name'], $dir.$fileName, null, null, $ext)) {
+            $errors[] = $this->trans('An error occurred while attempting to upload the file.', array(), 'Admin.Notifications.Error');
+            return false;
+        }
+        // ImageManager::resize() drops a helper "fileType" marker next to the image: not needed here.
+        @unlink($dir.'fileType');
+
+        return $fileName;
+    }
+
+    protected function removeLogoFile($fileName)
+    {
+        $fileName = basename((string) $fileName);
+        if ($fileName === '' || $fileName === 'index.php') {
+            return;
+        }
+        $path = $this->getLocalPath().'img/'.$fileName;
+        if (is_file($path)) {
+            @unlink($path);
+        }
+    }
